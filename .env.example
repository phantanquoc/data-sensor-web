# Backend API + Socket.IO. Giao diện chạy riêng ở port 5174 (Vite trong Docker).
PORT_SERVER=3000

# MongoDB. Chạy bằng docker-compose thì compose tự ghi đè thành mongodb://mongo:27017/mydb
MONGO_URI=mongodb://localhost:27017/mydb

# PLC Modbus TCP — each IP points to the HMI gateway for that fryer
IP_PLC1=192.168.1.1
IP_PLC2=192.168.1.2
IP_PLC3=192.168.1.3
IP_PLC4=192.168.1.4
IP_PLC5=192.168.1.5
IP_PLC6=192.168.1.6
IP_PLC7=192.168.1.7
IP_PLC8=192.168.1.8
PORT_PLC=502

# Debug logging (set to "true" or "1" to enable verbose output)
DEBUG=false

# ===== Đăng nhập (production) =====
# Tài khoản đăng nhập vào dashboard.
AUTH_USER=admin
AUTH_PASS=doi_mat_khau_nay
# Secret ký JWT — đặt chuỗi ngẫu nhiên dài. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# true khi chạy sau HTTPS (prod). Dev chạy HTTP qua Vite proxy thì để false/bỏ trống.
COOKIE_SECURE=false

# ===== Caddy / HTTPS (chỉ dùng cho docker-compose.prod.yml) =====
# Domain + cổng nội bộ Caddy phục vụ. Cloudflare (Proxied, SSL mode "Full")
# là lớp TLS công khai; Caddy chỉ dùng cert nội bộ (tls internal) nên không
# cần Let's Encrypt / Cloudflare token / port 80.
# Router NAT cổng Cloudflare (443 hoặc 8443) → 192.168.1.20:8090.
SITE_ADDRESS=quocvxt.top:8090
