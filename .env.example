# Backend API + Socket.IO. Giao diện chạy riêng ở port 5174 (Vite trong Docker).
PORT_SERVER=3000

# MongoDB. Chạy bằng docker-compose thì compose tự ghi đè thành mongodb://mongo:27017/mydb
MONGO_URI=mongodb://localhost:27017/mydb

# PLC Modbus TCP — each IP points to the HMI gateway for that fryer
IP_PLC1=192.168.1.1
IP_PLC2=192.168.1.2
IP_PLC3=192.168.1.3
IP_PLC4=192.168.1.4
IP_PLC5=192.168.1.5
IP_PLC6=192.168.1.6
IP_PLC7=192.168.1.7
IP_PLC8=192.168.1.8
PORT_PLC=502

# Debug logging (set to "true" or "1" to enable verbose output)
DEBUG=false
