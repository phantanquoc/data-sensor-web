# Frontend production: build React tĩnh rồi serve bằng Caddy.
# Caddy vừa serve file tĩnh, vừa reverse-proxy /socket.io + API sang backend,
# vừa phục vụ HTTPS bằng cert nội bộ (Cloudflare Full mode không kiểm cert origin).

# ---- Stage 1: build React ----
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# ---- Stage 2: serve (Caddy chuẩn, không cần plugin) ----
FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
