# Caddyfile cho test LOCAL: HTTP thuần ở cổng 8090 (không TLS, không Cloudflare).
# Dùng cùng route như prod để test đúng luồng. Truy cập http://localhost:8090
:8090 {
	encode gzip zstd
	root * /srv

	# Socket.IO — reverse_proxy tự nâng cấp WebSocket (Upgrade header)
	handle /socket.io/* {
		reverse_proxy iot-gateway:3000
	}

	# REST API → backend.
	@api path /api/* /thong_ke* /get_noi_chien* /sua_noi_chien_detail* /xoa_noi_chien_detail* /enable_machine*
	handle @api {
		reverse_proxy iot-gateway:3000
	}

	# SPA React fallback
	handle {
		try_files {path} /index.html
		file_server
	}
}
